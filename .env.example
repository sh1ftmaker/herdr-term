# Copy to .env (gitignored, chmod 600).
#
# The bridge relays keystrokes into a live shell and serves files from $HOME.
# Put an edge policy in front of it -- Cloudflare Access with an email
# allowlist is enough -- or leave the built-in gate on by setting a token
# instead of HERDR_TERM_NO_AUTH.

# Built-in shared-secret gate. Set NO_AUTH=1 only when something else (Access,
# a VPN, a private network) is doing the authenticating.
#HERDR_TERM_TOKEN=change-me
HERDR_TERM_NO_AUTH=1

HERDR_TERM_HOST=127.0.0.1
HERDR_TERM_PORT=8790

# Root of the Files tab (read-only). Defaults to $HOME; narrow it if the
# browser should only reach part of the home directory.
#HERDR_TERM_FS_ROOT=/home/<user>/Work

# moonlight-web (herdr-term-stream.service) runs on loopback and is reverse
# proxied under this path, so it shares the origin the edge policy protects.
# Both must match server/config.json in ~/.local/share/moonlight-web.
HERDR_TERM_MOONLIGHT_PORT=8791
HERDR_TERM_MOONLIGHT_PREFIX=/moonlight

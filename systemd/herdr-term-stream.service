[Unit]
Description=moonlight-web stream server (behind the herdr-term bridge)
Documentation=https://github.com/MrCreativ3001/moonlight-web-stream
# Deliberately no After=default.target: these units are WantedBy=default.target,
# so ordering after it forms a cycle and systemd silently drops start jobs.
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/moonlight-web
ExecStart=%h/.local/share/moonlight-web/web-server run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target

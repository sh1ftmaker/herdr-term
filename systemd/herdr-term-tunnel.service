[Unit]
Description=Cloudflare tunnel for the herdr-term bridge
After=herdr-term.service
Wants=herdr-term.service

[Service]
Type=simple
ExecStart=/usr/bin/cloudflared --no-autoupdate --config %h/herdr-term/cloudflared/config.yml tunnel run
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
